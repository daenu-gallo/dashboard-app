# Upload-API Environment
# Supabase (für JWT-Validierung)
SUPABASE_URL=http://debian.orca-mirfak.ts.net:3100
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-here

# NAS Mount
NAS_BASE_PATH=/mnt/nas/onlinegalerie

# Server
PORT=3200

# CORS – erlaubte Origins (kommasepariert)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Coolify (für Key-Rotation & Admin-Deploys)
COOLIFY_API_TOKEN=your-coolify-api-token
COOLIFY_BASE_URL=http://localhost:8000
COOLIFY_UUID_DASHBOARD=your-dashboard-uuid
COOLIFY_UUID_UPLOAD=your-upload-api-uuid
